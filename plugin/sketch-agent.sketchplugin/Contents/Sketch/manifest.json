{
  "$schema": "https://raw.githubusercontent.com/sketch-hq/SketchAPI/develop/docs/sketch-plugin-manifest-schema.json",
  "name": "Sketch Agent",
  "identifier": "com.sketch-ai.chat",
  "version": "1.0.0",
  "description": "AI-powered design assistant for Sketch",
  "author": "",
  "icon": "icon.png",
  "commands": [
    {
      "name": "Open Sketch Agent",
      "identifier": "sketch-agent.open",
      "script": "__script.js",
      "handler": "openChatPanel",
      "shortcut": "cmd shift a"
    },
    {
      "name": "Quit",
      "identifier": "sketch-agent.quit",
      "script": "__script.js",
      "handler": "onQuit"
    },
    {
      "script": "__script.js",
      "handlers": {
        "actions": {
          "OpenDocument": "openChatPanel",
          "Shutdown": "onShutdown"
        }
      }
    }
  ],
  "menu": {
    "title": "Sketch Agent",
    "items": [
      "sketch-agent.open",
      "sketch-agent.quit"
    ]
  },
  "disableCocoaScriptPreprocessor": true,
  "appcast": "https://raw.githubusercontent.com//master/.appcast.xml"
}